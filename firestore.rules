rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jonathanflp100@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: only authenticated users can read.
    // Self or admin can create initial profile.
    // Only admins can delete or change roles; non-admins cannot elevate their own role.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isSelf(userId));
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin();
    }

    // Company profile and global settings
    match /company/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Transactions (Financeiro)
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Bank and Cash Accounts
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Financial Categories
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // CRM Deals (Funil de Vendas)
    match /deals/{dealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deal Interactions history
    match /deal_interactions/{interactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deal Tasks
    match /deal_tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Products & Services Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Proposals / Quotes / Sales
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // General Tasks & Schedule
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Financial Transfers between accounts
    match /transfers/{transferId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
