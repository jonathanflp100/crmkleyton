rules_version = '2';

// Gestor Pro — regras de segurança
// - Só quem tem cadastro ATIVO em /users acessa os dados (criar conta no Firebase Auth não basta).
// - Funcionário cria e edita; só admin exclui, mexe em usuários e nos dados da empresa.
// - O primeiro admin é criado pela tela de "Primeiro acesso" (enquanto /system/setup não existir).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveUser() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && get(userDoc()).data.role == 'admin';
    }

    function setupDone() {
      return exists(/databases/$(database)/documents/system/setup);
    }

    // Tudo fechado por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Indica se o sistema já tem administrador (lido antes do login)
    match /system/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && getAfter(userDoc()).data.role == 'admin';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isActiveUser() || (signedIn() && request.auth.uid == userId);
      // primeiro admin (cadastro inicial) ou admin cadastrando funcionários
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == userId && !setupDone()
            && request.resource.data.role == 'admin');
      // usuário pode editar o próprio nome/telefone, mas não o perfil nem o status
      allow update: if isAdmin()
        || (isActiveUser() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    match /company/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Dados operacionais: funcionários criam e editam, só admin exclui
    match /{col}/{docId} {
      allow read, create, update: if isActiveUser() && col in [
        'clients', 'suppliers', 'transactions', 'accounts', 'categories',
        'deals', 'deal_interactions', 'products', 'proposals', 'tasks', 'transfers'
      ];
      allow delete: if isAdmin() && col in [
        'clients', 'suppliers', 'transactions', 'accounts', 'categories',
        'deals', 'deal_interactions', 'products', 'proposals', 'tasks', 'transfers'
      ];
    }

    // Auditoria: todos registram, ninguém altera
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }
  }
}
