# Firebase Configuration (Obrigatório para autenticação e Firestore)
# Obtenha estes valores no Console do Firebase (Configurações do Projeto > Seus aplicativos > SDK setup and configuration)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# URL da aplicação (opcional para referências)
APP_URL="https://gestorpro.seudominio.com"
